# CATATAN: vendor/ dan public/ TIDAK di-track individual lagi.
# Ribuan file kecil di vendor/ bikin checkout di cPanel gampang dianggap
# "uncommitted changes" (git status kotor) dan menolak deploy. Sekarang
# keduanya dikemas jadi vendor.tar.gz dan public.tar.gz (lihat DEPLOY.md),
# dan .cpanel.yml tinggal mengekstraknya di server.
#
# Untuk update salah satunya:
#   tar -czf vendor.tar.gz -C vendor .
#   tar -czf public.tar.gz -C public --exclude=storage --exclude=hot .
/vendor
/public/*
!/public/.gitkeep

/storage/*.key
/storage/pail
Homestead.json
Homestead.yaml
Thumbs.db
