# CATATAN: vendor/ dan public/ TIDAK ikut git sama sekali.
# Ribuan file kecil di vendor/ bikin checkout di cPanel gampang dianggap
# "uncommitted changes" dan deploy ditolak. Solusinya: vendor.zip dan
# public.zip diupload MANUAL lewat cPanel File Manager lalu di-extract
# pakai tombol Extract bawaan File Manager — lihat DEPLOY.md.
# .zip-nya sendiri juga sengaja tidak ikut git (dibuat ulang tiap perlu).
/vendor
/public/*
!/public/.gitkeep
/vendor.zip
/public.zip

/storage/*.key
/storage/pail
Homestead.json
Homestead.yaml
Thumbs.db
