# CATATAN: /public/build SENGAJA tidak di-ignore.
# Shared hosting cPanel tidak punya Node.js, jadi hasil `npm run build`
# harus ikut ter-commit supaya CSS/JS terkirim saat deploy.
/storage/*.key
/storage/pail
# CATATAN: /vendor SENGAJA tidak di-ignore.
# Composer di shared hosting cPanel terlalu lambat / sering timeout,
# jadi dependency production ikut ter-commit dan deploy tinggal menyalin.
# Isinya hasil `composer install --no-dev --optimize-autoloader`.
Homestead.json
Homestead.yaml
Thumbs.db
